# Copie para .env. Os valores abaixo funcionam com a API de exemplo (python mock_api.py).

# --- API -------------------------------------------------------------------------
API_URL=http://127.0.0.1:8765
ENDPOINT_LOGIN=/api/v1/login
ENDPOINT_LISTA=/api/v1/records
ENDPOINT_DETALHE=/api/v1/records/{id}/messages

# Autenticação: token fixo (Bearer) OU login com e-mail e senha
API_TOKEN=
API_EMAIL=demo@exemplo.com
API_SENHA=demo

# --- Coleta ----------------------------------------------------------------------
TIMEZONE=America/Sao_Paulo
PAGE_LIMIT=50          # teto de registros por página da API
JANELA_SEGURA=1000     # acima disso a janela de tempo é dividida ao meio
JANELA_MIN_SEG=60      # menor janela permitida, em segundos

# --- Relatório -------------------------------------------------------------------
TEMPLATES_PREFIXOS=status_pedido_          # vários separados por vírgula; vazio = todos
DESCARTAR_CAMPOS=contact.schema            # campos pesados que não vão para o arquivo bruto

# --- Execução --------------------------------------------------------------------
WORKERS=12             # requisições em paralelo no enriquecimento
TIMEOUT=60
MAX_TENTATIVAS=5
BACKOFF_BASE=1
DIR_SAIDA=saida
